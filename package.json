{
  "name": "mobile-game-studio",
  "private": true,
  "workspaces": [
    "packages/*",
    "games/*"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p packages/kit --noEmit && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
